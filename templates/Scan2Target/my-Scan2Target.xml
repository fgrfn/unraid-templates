<?xml version='1.0' encoding='utf-8'?>
<Container version="2">
  <Name>Scan2Target</Name>
  <Repository>ghcr.io/fgrfn/scan2target:latest</Repository>
  <Registry>https://github.com/fgrfn/Scan2Target</Registry>
  <Network>host</Network>
  <MyIP />
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/fgrfn/Scan2Target/issues</Support>
  <Project>https://github.com/fgrfn/Scan2Target</Project>
  <ReadMe>https://github.com/fgrfn/Scan2Target#readme</ReadMe>
  <Overview>Web-based scan server for USB and network scanners. Scan2Target discovers scanners and routes documents to file shares, mail, Paperless-ngx, webhooks and cloud providers.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:8000</WebUI>
  <TemplateURL>https://fgrfn.github.io/unraid-templates/templates/Scan2Target/my-Scan2Target.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/fgrfn/Scan2Target/main/static/favicon.ico</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs />
  <CPUset />
  <DateInstalled />
  <DonateText />
  <DonateLink />
  <Requires>Host networking is required for mDNS and scanner discovery. USB scanners also require access to /dev/bus/usb.</Requires>
  <Config Name="Data Volume" Target="/data" Default="/mnt/user/appdata/scan2target" Mode="rw" Description="Persistent database, configuration and scanned files." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/scan2target</Config>
  <Config Name="USB Devices" Target="/dev/bus/usb" Default="/dev/bus/usb" Mode="rw" Description="USB device access for locally attached scanners." Type="Path" Display="always" Required="true" Mask="false">/dev/bus/usb</Config>
  <Config Name="SCAN2TARGET_SECRET_KEY" Target="SCAN2TARGET_SECRET_KEY" Default="" Mode="env" Description="Encryption key for stored credentials; generate with openssl rand -base64 32." Type="Variable" Display="always" Required="true" Mask="true" />
  <Config Name="SCAN2TARGET_REQUIRE_AUTH" Target="SCAN2TARGET_REQUIRE_AUTH" Default="true" Mode="env" Description="Require authentication." Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="SCAN2TARGET_DATA_DIR" Target="SCAN2TARGET_DATA_DIR" Default="/data" Mode="env" Description="Internal data directory." Type="Variable" Display="advanced" Required="false" Mask="false">/data</Config>
  <Config Name="SCAN2TARGET_DATABASE_PATH" Target="SCAN2TARGET_DATABASE_PATH" Default="/data/db/scan2target.db" Mode="env" Description="Internal database file." Type="Variable" Display="advanced" Required="false" Mask="false">/data/db/scan2target.db</Config>
  <Config Name="SCAN2TARGET_LOG_DIR" Target="SCAN2TARGET_LOG_DIR" Default="/var/log/scan2target" Mode="env" Description="Internal log directory." Type="Variable" Display="advanced" Required="false" Mask="false">/var/log/scan2target</Config>
  <Config Name="SCAN2TARGET_HEALTH_CHECK_INTERVAL" Target="SCAN2TARGET_HEALTH_CHECK_INTERVAL" Default="60" Mode="env" Description="Health-check interval in seconds." Type="Variable" Display="advanced" Required="false" Mask="false">60</Config>
  <Config Name="SCAN2TARGET_SCANNER_CHECK_INTERVAL" Target="SCAN2TARGET_SCANNER_CHECK_INTERVAL" Default="30" Mode="env" Description="Scanner discovery interval in seconds." Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="env" Description="Container timezone." Type="Variable" Display="always" Required="false" Mask="false">Europe/Berlin</Config>
  <TailscaleStateDir />
</Container>
