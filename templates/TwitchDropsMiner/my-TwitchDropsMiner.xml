<?xml version='1.0' encoding='utf-8'?>
<Container version="2">
  <Name>TwitchDropsMiner</Name>
  <Repository>ghcr.io/fgrfn/twitch-drops-miner:latest</Repository>
  <Registry>https://github.com/fgrfn/TwitchDropsMiner</Registry>
  <Network>bridge</Network>
  <MyIP />
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/fgrfn/TwitchDropsMiner/issues</Support>
  <Project>https://github.com/fgrfn/TwitchDropsMiner</Project>
  <ReadMe>https://github.com/fgrfn/TwitchDropsMiner#readme</ReadMe>
  <Overview>Twitch Drops Miner farms eligible Twitch drops without keeping a stream open. It discovers campaigns, changes channels automatically, persists OAuth state and offers webhook notifications and a web interface.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL>https://fgrfn.github.io/unraid-templates/templates/TwitchDropsMiner/my-TwitchDropsMiner.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/fgrfn/TwitchDropsMiner/main/icons/pickaxe.ico</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs />
  <CPUset />
  <DateInstalled />
  <DonateText />
  <DonateLink />
  <Requires />
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Host port for the web interface." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data Volume" Target="/app/data" Default="/mnt/user/appdata/twitch-drops-miner/data" Mode="rw" Description="OAuth cookies, settings and state." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/twitch-drops-miner/data</Config>
  <Config Name="Logs Volume" Target="/app/logs" Default="/mnt/user/appdata/twitch-drops-miner/logs" Mode="rw" Description="Optional persistent logs." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/twitch-drops-miner/logs</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="env" Description="Container timezone." Type="Variable" Display="always" Required="false" Mask="false">Europe/Berlin</Config>
  <TailscaleStateDir />
</Container>
