<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>APP_NAME</Name>
  <Repository>OWNER/IMAGE:TAG</Repository>
  <Registry>https://hub.docker.com/r/OWNER/IMAGE</Registry>
  <Network>bridge</Network>
  <MyIP />
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/OWNER/PROJECT/issues</Support>
  <Project>https://github.com/OWNER/PROJECT</Project>
  <ReadMe>https://github.com/OWNER/PROJECT#readme</ReadMe>
  <Overview>Describe the application, its main purpose and important installation notes.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL>https://fgrfn.github.io/unraid-templates/templates/APP_FOLDER/my-APP_NAME.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/OWNER/PROJECT/main/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs />
  <CPUset />
  <DateInstalled />
  <DonateText />
  <DonateLink />
  <Requires />
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Host port for the web interface." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="AppData" Target="/config" Default="/mnt/user/appdata/app-name" Mode="rw" Description="Persistent application data." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/app-name</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="env" Description="Container timezone." Type="Variable" Display="always" Required="false" Mask="false">Europe/Berlin</Config>
  <TailscaleStateDir />
</Container>
